{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window — 2026-10-04 收窄：摘 fs:default（与下面 6 条逐条授权完全重复，但它是整个 fs 插件权限集）、shell:default 收成 shell:allow-open（scanner.ts 只用 open）。scope 维持 $HOME/.z-biz-tools/**，与 paths.ts 里写明的设计一致。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-start-dragging",
    "core:event:default",
    "core:tray:default",
    "core:webview:allow-internal-toggle-devtools",
    "clipboard-manager:default",
    "dialog:default",
    "fs:allow-mkdir",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/.z-biz-tools/**" },
        { "path": "$HOME/.z-biz-tools" }
      ]
    },
    {
      "identifier": "shell:allow-open",
      "allow": [{ "name": "open", "cmd": null, "args": true }]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://**:*"
        },
        {
          "url": "https://**:*"
        }
      ]
    },
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered"
  ]
}
